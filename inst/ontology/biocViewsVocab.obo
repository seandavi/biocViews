[Term]
id: BIOCVIEWS:0000001
name: BiocViews
def: "Root term for the Bioconductor Views ontology, a controlled vocabulary for categorizing Bioconductor packages." []

[Term]
id: BIOCVIEWS:0000002
name: AnnotationData
def: "Annotation data packages containing curated biological metadata, reference information, and mapping data." []
is_a: BIOCVIEWS:0000001 ! BiocViews

[Term]
id: BIOCVIEWS:0000003
name: ExperimentData
def: "Experimental data packages containing example datasets, published research data, and reproducible research materials." []
is_a: BIOCVIEWS:0000001 ! BiocViews

[Term]
id: BIOCVIEWS:0000004
name: Software
def: "Bioconductor software packages providing tools for computational biology and bioinformatics analysis." []
is_a: BIOCVIEWS:0000001 ! BiocViews

[Term]
id: BIOCVIEWS:0000005
name: Workflow
def: "Workflow packages demonstrating complete analysis pipelines and best practices for common bioinformatics tasks." []
is_a: BIOCVIEWS:0000001 ! BiocViews

